#!/bin/env bash

# PETUNJUK: Anda dapat menguji program dengan perintah berikut
# echo "1 + 1" | ./calculator

# Membaca ekspresi matematika dari input standar
read -r expression

# Menghitung hasil menggunakan bc
# Mendukung operasi penjumlahan, pengurangan, perkalian, dan pembagian
result=$(echo "$expression" | bc)

# Menampilkan hasil perhitungan
echo "$result"
