#!/bin/env bash

# Meminta input dari user
echo "Masukkan ekspresi matematika (Contoh: 10 + 5, 2 * 3, 10 / 4):"
read -r expression

# Evaluasi menggunakan Java (Jshell)
# Menggunakan (double) agar hasil pembagian ada komanya (misal 5/2 jadi 2.5)
result=$(echo "System.out.println((double)($expression));" | jshell -s -)

# Menampilkan hasil
echo "Hasilnya adalah: $result"
