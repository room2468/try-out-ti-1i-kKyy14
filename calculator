#!/usr/bin/env bash

#saya akan membuat program yang outputnya sama sesuai soal
read -r expression
#membaca ekspresi matematika dari input 
result=$(echo "System.out.println((double)($expression));" | jshell -s - | tail -n 1)
#menghitung menggunakan jshell
#tail -n diguakan untuk hasil akhir

if [[ $result == *.0 ]]; then
  result=${result%.0}
fi
#jika hasil serupa berupa bilangan bulat misalnya 2.0, hilangkan .0

echo "$result"
#menampilkan hasil akhir/outputnya
